 Execution Code

public class GamePOC {
    public static void main(String[] args) {
        // Hero ironMan = new Hero("Tony", 100); // ERROR: Cannot instantiate abstract classes directly
        
        IronMan tony = new IronMan("Iron Man", 100);
        AquaMan arthur = new AquaMan("AquaMan", 120);

        // Demonstrating Shared State & Concrete Behavior via Abstract Class
        tony.takeDamage(20);
        arthur.takeDamage(15);

        // Demonstrating Polymorphic Abstract Methods
        tony.attack();
        arthur.attack();

        // Demonstrating Interface capabilities
        tony.fly();
        arthur.swim();
    }
}
