public class Main {

    static void calculate() {
        int result = 10 / 0;
    }

    static void service() {
        calculate();
    }

    public static void main(String[] args) {
        try {
            service();
        } catch (ArithmeticException e) {
            System.out.println("Handled in main()");
        }
    }
}

