class DumbAppliance {
    void turnOn() {
        // The old coffee machine or fan just goes 'click' and starts buzzing
        System.out.println("Power relay clicked. Device is humming to life.");
    }
}

class LivingRoomBulb extends DumbAppliance {
    @Override
    void turnOn() {
        // Smart lights don't just flash on; they fade in gently so they don't blind you
        System.out.println("Fading bulb to 60% warmth. Setting the perfect movie night lighting.");
    }
}

public class SmartHome {
    public static void main(String[] args) {
        DumbAppliance gadget = new LivingRoomBulb();
        gadget.turnOn();
    }
}
