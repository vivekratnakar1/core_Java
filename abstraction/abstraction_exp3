
//A normal class that hides its internal steps
class OrderService {
 
 // 1. Exposed functionality: Other classes can call this to place an order
 public void placeOrder(String item) {
     System.out.println("Processing order for: " + item);
     
     // 2. Automatically runs the hidden core functionalities in order
     checkStock();
     processPayment();
 }

 // 3. Hidden core functionality
 private void checkStock() {
     System.out.println("- Internal: Stock checked successfully.");
 }

 // 4. Hidden core functionality
 private void processPayment() {
     System.out.println("- Internal: Payment processed successfully.");
 }
}
